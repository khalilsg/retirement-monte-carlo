#!/bin/sh
# Block a push that fails the test suite or doesn't bump src/version.js.
#
# Two gates, both reported before exiting so one push tells you everything that
# needs fixing:
#
#   1. node --test over test/ — the pure engine, config, and codec. No
#      dependencies, no browser, runs in about a second.
#   2. src/version.js has moved. The version string tracks what's live, so every
#      push should move it. Scheme:
#        more than one push in a day  -> third number   (1.2.0 -> 1.2.1)
#        first push of the day, minor -> second number  (1.2   -> 1.3)
#        first push of the day, major -> first number   (1.x   -> 2.0)
#
# The browser check (tools/browser-check.mjs) is not run here: it needs Playwright
# and a few seconds of real page. Run it by hand before anything that touches the
# UI or the charts.
#
# Enable (once per clone): git config core.hooksPath .githooks
# Bypass for a genuine non-shipping push: git push --no-verify

VERSION_FILE="src/version.js"
ZERO="0000000000000000000000000000000000000000"
status=0

# ---------- 1. tests ----------
if command -v node >/dev/null 2>&1; then
	out=$(mktemp)
	if ! node --test --test-reporter=spec test/*.test.js >"$out" 2>&1; then
		echo "" >&2
		echo "  push blocked: the test suite fails" >&2
		echo "" >&2
		# Just the names of the failing tests, taken from the reporter's own
		# summary so they aren't listed twice. The full report, with assertion
		# messages, is one command away and doesn't belong in a hook's output.
		awk "/failing tests:/{f=1;next} f" "$out" | grep "✖" | sed "s/^/  /" | head -20 >&2
		echo "" >&2
		echo "  run: node --test --test-reporter=spec test/*.test.js" >&2
		echo "" >&2
		status=1
	fi
	rm -f "$out"
else
	echo "  note: node not found, skipping tests" >&2
fi

# ---------- 2. version bump ----------
while read -r local_ref local_sha remote_ref remote_sha; do
	# Branch deletion — nothing to check.
	[ "$local_sha" = "$ZERO" ] && continue

	if [ "$remote_sha" = "$ZERO" ]; then
		# New branch on the remote; no baseline to diff against.
		continue
	fi

	if git diff --quiet "$remote_sha" "$local_sha" -- "$VERSION_FILE"; then
		current=$(git show "$local_sha:$VERSION_FILE" 2>/dev/null | sed -n "s/.*VERSION = '\(.*\)'.*/\1/p")
		today=$(git log --since=midnight --oneline "$local_sha" 2>/dev/null | wc -l | tr -d ' ')

		echo "" >&2
		echo "  push blocked: $VERSION_FILE is unchanged (currently ${current:-unknown})" >&2
		echo "" >&2
		if [ "$today" -gt 0 ]; then
			echo "  $today commit(s) already today -> bump the third number" >&2
		else
			echo "  first push today -> bump the second number (minor)," >&2
			echo "  or the first number if this ships new features" >&2
		fi
		echo "" >&2
		echo "  edit $VERSION_FILE, amend or commit the bump, then push again." >&2
		echo "  (not a shipping change? git push --no-verify)" >&2
		echo "" >&2
		status=1
	fi
done

exit $status
