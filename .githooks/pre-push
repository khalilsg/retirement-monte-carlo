#!/bin/sh
# Block a push that doesn't bump src/version.js.
#
# The version string tracks what's live, so every push should move it. Scheme:
#   more than one push in a day  -> third number   (1.2.0 -> 1.2.1)
#   first push of the day, minor -> second number  (1.2   -> 1.3)
#   first push of the day, major -> first number   (1.x   -> 2.0)
#
# Enable (once per clone): git config core.hooksPath .githooks
# Bypass for a genuine non-shipping push: git push --no-verify

VERSION_FILE="src/version.js"
ZERO="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	# Branch deletion — nothing to check.
	[ "$local_sha" = "$ZERO" ] && continue

	if [ "$remote_sha" = "$ZERO" ]; then
		# New branch on the remote; no baseline to diff against.
		continue
	fi

	if git diff --quiet "$remote_sha" "$local_sha" -- "$VERSION_FILE"; then
		current=$(git show "$local_sha:$VERSION_FILE" 2>/dev/null | sed -n "s/.*VERSION = '\(.*\)'.*/\1/p")
		today=$(git log --since=midnight --oneline "$local_sha" 2>/dev/null | wc -l | tr -d ' ')

		echo "" >&2
		echo "  push blocked: $VERSION_FILE is unchanged (currently ${current:-unknown})" >&2
		echo "" >&2
		if [ "$today" -gt 0 ]; then
			echo "  $today commit(s) already today -> bump the third number" >&2
		else
			echo "  first push today -> bump the second number (minor)," >&2
			echo "  or the first number if this ships new features" >&2
		fi
		echo "" >&2
		echo "  edit $VERSION_FILE, amend or commit the bump, then push again." >&2
		echo "  (not a shipping change? git push --no-verify)" >&2
		echo "" >&2
		status=1
	fi
done

exit $status
